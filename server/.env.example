# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# Option A: a single connection string (used in production / Render).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/template_store
# DATABASE_SSL=false

# Option B: individual settings for local development (used when DATABASE_URL is unset).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_NAME=template_store

# Test database. Tests refuse to run unless the name ends with "_test" and wipe it on every run.
DB_NAME_TEST=template_store_test
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/template_store_test

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# --- HTTP -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
# Number of proxy hops in front of the API (1 on Render, 0 locally).
TRUST_PROXY=0
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Copy to client/.env.local if you need to override defaults.

# Base URL of the API. Leave unset in development: Vite proxies /api to http://localhost:4000.
# In production (Vercel) set it to your Render URL, e.g. https://template-store-api.onrender.com/api
# VITE_API_URL=https://your-api.onrender.com/api

# Where the Vite dev proxy forwards /api requests (development only).
# VITE_DEV_API_PROXY=http://localhost:4000

# Environment variables for Mini SaaS Template Store. Placeholder values only.
#
# There are two ways to run the app locally:
#   1. Docker Compose  → copy THIS file to ./.env (repository root) and edit the values below.
#   2. Without Docker  → use server/.env (from server/.env.example) and optionally
#                        client/.env.local (from client/.env.example).

# ---------- Docker Compose (./.env) ----------
# Credentials for the PostgreSQL container (also passed to the API container).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_DB=template_store

# JWT signing secret for the API. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Host ports. The database defaults to 5433 to avoid clashing with a local PostgreSQL.
WEB_PORT=5173
API_PORT=4000
DB_PUBLISHED_PORT=5433

# Poll for file changes in the client container (needed for hot reload on Docker Desktop).
VITE_USE_POLLING=true

# ---------- Reference: server/.env (non-Docker) ----------
# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/template_store   # production
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-local-postgres-password
# DB_NAME=template_store
# DB_NAME_TEST=template_store_test
# CORS_ORIGIN=http://localhost:5173
# TRUST_PROXY=0

# ---------- Reference: client/.env.local (non-Docker) ----------
# VITE_API_URL=https://your-api.onrender.com/api   # production only; dev uses the Vite proxy
